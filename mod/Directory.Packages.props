<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5 (Mono, x64) -->
    <PackageVersion Include="BepInEx.Core"            Version="5.4.21" />
    <PackageVersion Include="BepInEx.PluginInfoProps" Version="2.1.0" />

    <!-- Unity reference assemblies. MUST match the engine version WorldBox ships (see /health
         unity_version; 0.51.2 = 2022.3.60f1). Compile-time only: at runtime the plugin binds to
         the game's real UnityEngine.*.dll. Keeps the build independent of a local game install,
         so CI and release builds work on a bare runner. -->
    <PackageVersion Include="UnityEngine.Modules"     Version="2022.3.60" />

    <!-- net462 targeting pack. Referenced explicitly, not left to the SDK's implicit import:
         the SDK only adds it on machines without the .NET Framework targeting packs (Linux and
         macOS), so leaving it implicit makes the restore graph differ per OS and packages.lock.json
         fails with NU1004 on the Windows CI runner. Explicit keeps all three platforms identical. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />

    <!-- JSON: WorldBox ships its own Newtonsoft.Json (Newtonsoft.Json-for-Unity 13.0.2) in
         Managed/, and that is what the plugin binds to at runtime. The nuget version MUST NOT
         exceed the game's: 13.0.4 added JToken.ToString(Formatting), the compiler prefers it
         over the params overload, and the game's 13.0.2 throws MissingMethodException. -->
    <PackageVersion Include="Newtonsoft.Json"         Version="13.0.2" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"  Version="18.10.1" />
    <PackageVersion Include="xunit"                   Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions"        Version="6.12.2" />
  </ItemGroup>
</Project>
