<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>WorldBoxBridge</AssemblyName>
    <RootNamespace>WorldBoxBridge</RootNamespace>
    <!-- This is the SemVer source of truth, kept in sync by release-please. -->
    <Version>0.4.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Description>BepInEx plugin exposing a local HTTP API to WorldBox internals.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core"/>
    <PackageReference Include="BepInEx.PluginInfoProps"/>
    <PackageReference Include="Newtonsoft.Json"/>
    <!-- Explicit so the restore graph is identical on Windows, Linux and macOS. See the comment
         on its PackageVersion in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all"/>
  </ItemGroup>

  <!-- UnityEngine reference assemblies from NuGet (version pinned centrally). Compile-time only,
       never copied next to the plugin: BepInEx loads the game's own UnityEngine.*.dll. The mod
       reaches WorldBox's own code (Assembly-CSharp) purely via reflection, so it needs no
       reference to the game install at all. -->
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" ExcludeAssets="runtime" PrivateAssets="all"/>
  </ItemGroup>

</Project>
