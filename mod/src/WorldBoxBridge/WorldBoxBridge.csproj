<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>WorldBoxBridge</AssemblyName>
    <RootNamespace>WorldBoxBridge</RootNamespace>
    <!-- This is the SemVer source of truth, kept in sync by release-please. -->
    <Version>0.3.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Description>BepInEx plugin exposing a local HTTP API to WorldBox internals.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core"/>
    <PackageReference Include="BepInEx.PluginInfoProps"/>
    <PackageReference Include="HarmonyX"/>
    <PackageReference Include="Newtonsoft.Json"/>
  </ItemGroup>

  <!-- UnityEngine + Assembly-CSharp resolved from a local WorldBox install (see Directory.Build.props). -->
  <ItemGroup Condition="'$(HaveWorldBoxRefs)' == 'true'">
    <Reference Include="UnityEngine">
      <HintPath>$(WorldBoxManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WorldBoxManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(WorldBoxManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(WorldBoxManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(WorldBoxManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(WorldBoxManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
